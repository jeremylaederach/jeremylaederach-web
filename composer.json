{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jeremylaederach/jeremylaederach-web",
    "type": "project",
    "description": "Bilingual Laravel portfolio and static deployment pipeline for Jeremy Läderach.",
    "keywords": [
        "blade",
        "laravel",
        "portfolio",
        "static-site"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm ci",
            "npm run build"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@analyse",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
